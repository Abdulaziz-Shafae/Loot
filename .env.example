# Set these as environment variables in your IDE or shell.
# Spring Boot does not automatically load this file.
DB_URL=jdbc:mysql://localhost:3306/loot
DB_USERNAME=loot
DB_PASSWORD=replace-with-your-database-password
# Fresh development database only: update. Production: validate.
DDL_AUTO=validate
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-mail-account
MAIL_PASSWORD=replace-with-mail-app-password
MAIL_FROM=replace-with-sender@example.com
MAIL_AUTH=true
MAIL_TLS=true
OPENAI_API_KEY=replace-with-server-side-key
# Defaults to the model from the supplied backend; use a model your API account supports.
OPENAI_MODEL=gpt-5.6-luna
# Production additionally sets SPRING_PROFILES_ACTIVE=prod, HTTPS, and a real FRONTEND_ORIGINS value.

